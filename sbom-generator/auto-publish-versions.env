# Changes here trigger checked generator publication on main, followed by
# Renovate updates to the generator digest used by extension image builds.
# Only include tools such as Syft that determine SBOM inventory contents.
# Keep runtime and SPDX validation dependencies in the Dockerfile or dependencies/;
# changes there run checks without automatic publication, even for package additions
# or removals. They ship with the next generator release. Maintainers can force an
# earlier release (e.g. for security fixes) with publish_latest=true on main;
# this takes precedence over publish=true and runs the same publication checks.

# renovate: datasource=github-releases depName=anchore/syft versioning=semver
SYFT_VERSION=1.55.0
